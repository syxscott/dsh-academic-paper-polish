{
  "name": "dsh-academic-paper-polish",
  "version": "3.2.1",
  "private": true,
  "type": "module",
  "description": "Academic paper polish skill for DeepSeek Harness: writing, polishing, journal matching, submission and reviewer response.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./skill/*": "./skill/*"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skill",
    "README.md",
    "NOTICE",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skill",
    "academic",
    "paper",
    "polish",
    "writing",
    "publication"
  ]
}
